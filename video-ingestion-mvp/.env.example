# Storage
STORAGE_ROOT=/Users/你的用户名/VideoIngestionStorage
DATABASE_URL="file:./dev.db"

# AI provider:
# mock | openai | volcengine | local | local_openai_compatible | local_ollama
AI_PROVIDER=mock
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=
AI_API_KEY=
AI_FALLBACK_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
# OPENAI_PROXY_URL=http://127.0.0.1:7890

# Volcengine Ark
ARK_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_PROXY_URL=http://127.0.0.1:7890

# AI request controls
AI_FRAME_MAX=5
AI_IMAGE_DETAIL=low
AI_REQUEST_TIMEOUT_MS=60000

# Local provider healthcheck only in current V1.
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=
LOCAL_AI_HEALTHCHECK_URL=
