# Storage
STORAGE_ROOT=/Users/你的用户名/VideoIngestionStorage
DATABASE_URL="file:./dev.db"
AUTH_SECRET=请替换为至少32位随机字符串

# AI provider:
# mock | openai | volcengine | local | local_openai_compatible | local_ollama
AI_PROVIDER=mock
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=
AI_API_KEY=
AI_FALLBACK_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
# OPENAI_PROXY_URL=http://127.0.0.1:7890

# Volcengine Ark
ARK_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_PROXY_URL=http://127.0.0.1:7890

# AI request controls
AI_FRAME_MAX=5
AI_IMAGE_DETAIL=low
AI_REQUEST_TIMEOUT_MS=60000

# OpenAI-compatible relay or local OpenAI-style service.
# Set AI_PROVIDER=local_openai_compatible, then configure these values.
# LOCAL_AI_BASE_URL should usually include /v1, for example https://your-relay.example.com/v1
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=
# Only used by local_ollama or legacy local checks.
LOCAL_AI_HEALTHCHECK_URL=

# Optional first-run admin overrides
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=超级管理员
# INITIAL_ADMIN_PASSWORD=
